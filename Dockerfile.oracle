FROM python:3.11-alpine

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

# Copy oracle source code and consensus match database
COPY oracle_service.py active_matches.json ./

ENV PORT=8080
ENV SETTLEMENT_INTERVAL=20
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-8080}/health || exit 1

ENTRYPOINT ["python3", "oracle_service.py", "--daemon"]
